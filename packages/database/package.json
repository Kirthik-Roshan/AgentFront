{
  "name": "@agentfront/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:migrate": "prisma migrate deploy --config prisma.config.ts",
    "db:push": "prisma db push --config prisma.config.ts",
    "db:seed": "prisma db seed --config prisma.config.ts"
  },
  "dependencies": {
    "@agentfront/integrations": "0.1.0",
    "@agentfront/orchestration": "0.1.0",
    "@agentfront/types": "0.1.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1"
  },
  "devDependencies": {
    "prisma": "7.9.1"
  }
}
