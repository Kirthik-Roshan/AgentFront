# Core services
# Optional. Leave blank for the credential-free in-memory demo.
DATABASE_URL=
# Legacy local Redis service; not used by the PostgreSQL queue or planned SQS adapter.
REDIS_URL=
HOST=127.0.0.1
PORT=4000
WEB_ORIGIN=http://localhost:3000
# Optional runtime build root. Blank uses ignored .agentfront-runtime/generated-sites.
AGENTFRONT_OUTPUT_ROOT=

# Public browser configuration.
# Discover uses free OpenStreetMap tiles through Leaflet and needs no browser
# map key. Keep server discovery credentials below; never prefix them with VITE_.
VITE_API_BASE_URL=
# Optional production tile-provider override. Keep both blank for the default
# OpenStreetMap tile service. If changed, set the provider's required visible
# attribution as well.
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=

# Optional for local development. Required on non-loopback binds and in
# production unless the explicit loopback-only demo bypass below is enabled.
AGENTFRONT_API_TOKEN=
# Optional independent HMAC secret for the HttpOnly founder session. When blank,
# the server derives a signing key from AGENTFRONT_API_TOKEN.
AGENTFRONT_SESSION_SECRET=
# Never enable this on an exposed deployment. It exists only for an intentional
# production-mode demonstration still bound to a loopback address.
ALLOW_UNAUTHENTICATED_LOOPBACK_DEMO=false
# Authenticated provider diagnostics are cached/coalesced for this many ms.
AGENTFRONT_HEALTH_TTL_MS=30000

# Discovery
# Server-only key for Places API (New) and Geocoding API. Never prefix with VITE_.
GOOGLE_PLACES_API_KEY=

# Freshworks CRM
FRESHWORKS_DOMAIN=
FRESHWORKS_API_KEY=

# Realtime conversation
# LEGACY browser conversation provider only. Real sales telephony now uses the
# separately configured Sarvam + Vobiz adapter below; ElevenLabs remains optional.
VOICE_PROVIDER=elevenlabs
# Both remain server-only. The browser receives only a just-in-time, short-lived
# signed URL after explicit microphone/transcript consent.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Separate high-entropy Bearer secret for the trusted ElevenLabs server tool (or
# a post-call adapter) that submits a governed, provider-correlated completion.
# Do not reuse ELEVENLABS_API_KEY or expose this through a VITE_ variable.
ELEVENLABS_TOOL_SECRET=

# Telephony
# `demo` is an explicitly simulated provider for local/finals demonstrations.
# Selecting an unconfigured real provider reports UNAVAILABLE and never fakes a
# successful phone call.
TELEPHONY_PROVIDER=demo
TELEPHONY_WEBHOOK_SECRET=
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=
EXOTEL_PHONE_NUMBER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
VOBIZ_API_KEY=
VOBIZ_API_TOKEN=
VOBIZ_PHONE_NUMBER=

# Durable PostgreSQL sales/workflow jobs. AWS SQS/EventBridge adapters and
# scheduled autonomous Discover are later phases and these settings are reserved.
SALES_WORKER_ENABLED=true
SALES_WORKER_POLL_MS=5000
SALES_JOB_LEASE_MS=60000
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SQS_SALES_QUEUE_URL=
AWS_SQS_QUEUE_URL=
AWS_EVENT_BUS_NAME=
DISCOVERY_CRON=
GLOBAL_EMERGENCY_STOP=false
# The stopped flag is also persisted in PostgreSQL and can be changed via the
# authenticated /api/control/emergency-stop endpoint. Environment=true wins.

# Build and deployment
# `openai` performs one bounded Responses API customization of business.config.json
# in the selected existing template. `demo` never invokes an external model.
DEVELOPER_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# Optional legacy provider.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
# Legacy local CLI fallback; ignored when an API developer provider is selected.
CODEX_ENABLED=false
# The current deployment adapter uses the Vercel CLI with this server-only
# token after deterministic QA passes.
DEPLOY_PROVIDER=demo
DEPLOY_TOKEN=
MAX_BUILD_RETRIES=2
MAX_CLAUDE_CALLS_PER_BUILD=1
MAX_OPENAI_CALLS_PER_BUILD=1
# Fixed SpiceRoute hackathon agreement used by Sarvam and payment eligibility.
SPICEROUTE_DEMO_PRICE_INR=100

# Sarvam Voice Agents + Vobiz Instant Outbound. Default mode is restricted to
# the SpiceRoute seed and one opted-in founder phone. The optional discovered-
# destination policy remains founder-triggered and confirms the exact Place
# phone; it never enables autonomous dialing. Private dial targets are never
# copied into a generated website.
# A public website phone is not required to place the call. Configure it later
# only if a won call should be allowed to create a website specification.
# See docs/SARVAM_SALES_AGENT.md.
DEMO_BUSINESS_PHONE=
DEMO_PUBLIC_BUSINESS_PHONE=
SARVAM_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_SALES_APP_ID=
SARVAM_SALES_APP_VERSION=
SARVAM_CONNECTION_ID=
SARVAM_AGENT_PHONE_NUMBER=
# Manual or persistent deployments must generate a separate random value of at
# least 24 characters. The local `npm run dev:sarvam` launcher overrides this
# with a fresh process-only token and callback URL on every start. Sarvam does
# not currently document a webhook signature, so the callback also requires
# persisted attempt/business/call correlation.
SARVAM_WEBHOOK_TOKEN=
# Example: https://api.example.com/api/webhooks/sarvam/outbound?token=<same token>
# This must be public HTTPS; do not use localhost.
SARVAM_OUTBOUND_WEBHOOK_URL=
SARVAM_ALLOWED_BUSINESS_ID=business-spiceroute
# Explicit opt-in: dial a founder-approved Google Places phone instead of only DEMO_BUSINESS_PHONE.
SARVAM_ALLOW_DISCOVERED_DESTINATIONS=false
MAX_CALL_ATTEMPTS=3
MIN_CALL_INTERVAL_MINUTES=60

# Planned GitHub repository automation; it is not required for the bounded
# template → QA → direct Vercel demo path.
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY=
GITHUB_ORG=
VERCEL_ACCESS_TOKEN=
VERCEL_TEAM_ID=

# Freshdesk support adapter is available for manual/service use. Automatic
# exception-ticket dispatch is not wired yet; this is distinct from Freshsales.
FRESHDESK_DOMAIN=
FRESHDESK_API_KEY=
# Existing support requester address used for AgentFront operational tickets.
FRESHDESK_REQUESTER_EMAIL=

# Advertisement and supervisor adapters are planned. Delivery email supports Gmail OAuth.
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
MAX_DAILY_AD_BUDGET=0
MAX_TOTAL_CAMPAIGN_BUDGET=0
WISPR_FLOW_ENABLED=false

# Delivery email through the Gmail API. Enable Gmail API in the Google Cloud
# project and authorize only https://www.googleapis.com/auth/gmail.send with
# offline access once to obtain the refresh token. Keep all values server-only.
NOTIFICATION_PROVIDER=gmail
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
# Optional alternative provider; unused when NOTIFICATION_PROVIDER=gmail.
RESEND_API_KEY=
DELIVERY_EMAIL_FROM=

# Dodo Payments — hackathon checkout is deliberately test-mode only. Create a
# one-time test product priced to the exact accepted SpiceRoute deal (₹100 =
# 10000 paise). The API refuses checkout unless PostgreSQL records a won deal
# and a REAL deployed site, and marks payment only after a signed webhook.
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_TEST_PRODUCT_ID=
DODO_TEST_BUSINESS_ID=
DODO_TEST_EXPECTED_AMOUNT_MINOR=10000
DODO_TEST_RETURN_URL=http://localhost:3000/#/demo

# Leave blank for per-provider automatic selection. Set true only to force every
# integration to its clearly labelled demo adapter, even when credentials exist.
DEMO_MODE=
