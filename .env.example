# Core services
# Optional. Leave blank for the credential-free in-memory demo.
DATABASE_URL=
# Reserved for the future distributed worker topology; unused by Stage-1.
REDIS_URL=
HOST=127.0.0.1
PORT=4000
WEB_ORIGIN=http://localhost:3000
# Optional runtime build root. Blank uses ignored .agentfront-runtime/generated-sites.
AGENTFRONT_OUTPUT_ROOT=

# Public browser configuration.
# Discover uses free OpenStreetMap tiles through Leaflet and needs no browser
# map key. Keep server discovery credentials below; never prefix them with VITE_.
VITE_API_BASE_URL=
# Optional production tile-provider override. Keep both blank for the default
# OpenStreetMap tile service. If changed, set the provider's required visible
# attribution as well.
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=

# Optional for local development. Required on non-loopback binds and in
# production unless the explicit loopback-only demo bypass below is enabled.
AGENTFRONT_API_TOKEN=
# Optional independent HMAC secret for the HttpOnly founder session. When blank,
# the server derives a signing key from AGENTFRONT_API_TOKEN.
AGENTFRONT_SESSION_SECRET=
# Never enable this on an exposed deployment. It exists only for an intentional
# production-mode demonstration still bound to a loopback address.
ALLOW_UNAUTHENTICATED_LOOPBACK_DEMO=false
# Authenticated provider diagnostics are cached/coalesced for this many ms.
AGENTFRONT_HEALTH_TTL_MS=30000

# Discovery
# Server-only key for Places API (New) and Geocoding API. Never prefix with VITE_.
GOOGLE_PLACES_API_KEY=

# Freshworks CRM
FRESHWORKS_DOMAIN=
FRESHWORKS_API_KEY=

# Realtime conversation
# Both remain server-only. The browser receives only a just-in-time, short-lived
# signed URL after explicit microphone/transcript consent.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Separate high-entropy Bearer secret for the trusted ElevenLabs server tool (or
# a post-call adapter) that submits a governed, provider-correlated completion.
# Do not reuse ELEVENLABS_API_KEY or expose this through a VITE_ variable.
ELEVENLABS_TOOL_SECRET=

# Build and deployment
CODEX_ENABLED=
DEPLOY_PROVIDER=demo
DEPLOY_TOKEN=

# Leave blank for per-provider automatic selection. Set true only to force every
# integration to its clearly labelled demo adapter, even when credentials exist.
DEMO_MODE=
